<?xml version="1.0" encoding="UTF-8"?>
<!-- You may freely edit this file. See commented blocks below for -->
<!-- some examples of how to customize the build. -->
<!-- (If you delete it and reopen the project it will be recreated.) -->
<!-- By default, only the Clean and Build commands use this build script. -->
<!-- Commands such as Run, Debug, and Test only use this build script if -->
<!-- the Compile on Save feature is turned off for the project. -->
<!-- You can turn off the Compile on Save (or Deploy on Save) setting -->
<!-- in the project's Project Properties dialog box.-->
<project name="Sylt" default="default" basedir=".">
    <description>Builds, tests, and runs the project Sylt.</description>
    <import file="nbproject/build-impl.xml"/>
    <!--

    There exist several targets which are by default empty and which can be 
    used for execution of your tasks. These targets are usually executed 
    before and after some main targets. They are: 

      -pre-init:                 called before initialization of project properties
      -post-init:                called after initialization of project properties
      -pre-compile:              called before javac compilation
      -post-compile:             called after javac compilation
      -pre-compile-single:       called before javac compilation of single file
      -post-compile-single:      called after javac compilation of single file
      -pre-compile-test:         called before javac compilation of JUnit tests
      -post-compile-test:        called after javac compilation of JUnit tests
      -pre-compile-test-single:  called before javac compilation of single JUnit test
      -post-compile-test-single: called after javac compilation of single JUunit test
      -pre-jar:                  called before JAR building
      -post-jar:                 called after JAR building
      -post-clean:               called after cleaning build products

    (Targets beginning with '-' are not intended to be called on their own.)

    Example of inserting an obfuscator after compilation could look like this:

        <target name="-post-compile">
            <obfuscate>
                <fileset dir="${build.classes.dir}"/>
            </obfuscate>
        </target>

    For list of available properties check the imported 
    nbproject/build-impl.xml file. 


    Another way to customize the build is by overriding existing main targets.
    The targets of interest are: 

      -init-macrodef-javac:     defines macro for javac compilation
      -init-macrodef-junit:     defines macro for junit execution
      -init-macrodef-debug:     defines macro for class debugging
      -init-macrodef-java:      defines macro for class execution
      -do-jar:                  JAR building
      run:                      execution of project 
      -javadoc-build:           Javadoc generation
      test-report:              JUnit report generation

    An example of overriding the target for project execution could look like this:

        <target name="run" depends="Sylt-impl.jar">
            <exec dir="bin" executable="launcher.exe">
                <arg file="${dist.jar}"/>
            </exec>
        </target>

    Notice that the overridden target depends on the jar target and not only on 
    the compile target as the regular run target does. Again, for a list of available 
    properties which you can use, check the target you are overriding in the
    nbproject/build-impl.xml file. 

    -->
    <!--
        Phase 1 (aus Brocken): Prüfung von lib/Renderer.jar. Die Element-Packages liegen nicht im Projekt: ihre Quelle ist
        das Projekt Renderer (Paketvertrag Punkt 11, dort übersetzt tools/PaketPruefung.java jedes Package einzeln). Hier
        prüft tools/JarPruefung.java nach jedem Übersetzen, ob lib/Renderer.jar alles hat, was Sylt braucht (jedes Package
        mit Klassen und README, Java 21, Kern, Shader und Prüfklassen von surf, dune und beacon); abschalten mit
        -Dohne.paketpruefung=true.
    -->
    <target name="check-packages" description="Prüft lib/Renderer.jar: alle gebrauchten Packages mit README, Java 21, surf, dune, beacon." unless="ohne.paketpruefung">
        <property name="platform.java" value="java"/>
        <exec executable="${platform.java}" dir="${basedir}" failonerror="true">
            <arg value="-Dstdout.encoding=UTF-8"/>
            <arg value="-Dstderr.encoding=UTF-8"/>
            <arg value="tools/JarPruefung.java"/>
            <arg value="lib/Renderer.jar"/>
        </exec>
    </target>
    <target name="-post-compile" depends="check-packages"/>
    <!-- Phase 1: Prüfprogramm der App ohne Grafikkarte und Datenbank (endet mit "ERGEBNIS: alles in Ordnung"). -->
    <target name="pruefung" depends="compile-test" description="Startet die Prüfung com.dan.sylt.test.Pruefung.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.sylt.test.Pruefung" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <jvmarg value="-Xmx4g"/>
            <classpath><pathelement path="${run.test.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 16: db/sql/04_startdaten.sql aus com.dan.sylt.data.Startdaten neu schreiben (Quellen, Befunde, Sturmfluten,
         Vorspülungen, Gelände und Kante 2024 aus daten/, Lagen, Leuchtfeuer, Regiebücher, Ansichten, Fahrten, Presets). -->
    <target name="startdaten" depends="jar" description="Phase 16: db/sql/04_startdaten.sql neu erzeugen (nicht von Hand ändern).">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.sylt.data.StartdatenSql" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <arg value="daten"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 16: Prüfung mit der Datenbank (richtet ein, schreibt eine Chronik am 31.12.2099, räumt sie wieder weg). -->
    <target name="dbpruefung" depends="compile-test" description="Phase 16: Prüfung mit dem Schema SYLT (DbPruefung).">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.sylt.test.DbPruefung" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <jvmarg value="-Xmx4g"/>
            <classpath><pathelement path="${run.test.classpath}"/></classpath>
        </java>
    </target>
    <!-- Das Statusbild auf der Grafikkarte: docs/status/Status_Phase${phase}.png (Grundansicht von See auf die Küste,
         20.7.2026 20:30 MESZ, Stufe Mittel, Full HD, volles HUD mit den Zeiten jedes Durchgangs). Auf der Radeon laufen
         lassen; die Zeiten stehen auch in der Ausgabe. -Dansicht=Name wählt eine der neun Ansichten, -Dbild=… den Namen des Bilds; seit Phase 3 -Dwolken=aus, -Dboden=aus, -Dbedeckung=Achtel; seit Phase 4a -Dkamera=x,z,Richtung,Neigung,Höhe; seit Phase 7a -Dsee=H_s,T_p,Richtung (etwa 2,9,290), -Dpegel=m (von Hand, sonst die Tide), -Duhr=Stunde und -Ddatum=JJJJ-MM-TT; seit Phase 9a -Dsandsturm=an und -Dwind=m/s,Richtung; seit Phase 10 -Dvorlage=Leuchturm1 … Kampen4 (Ansicht, Tag und Stunde der Vorlage) und -Dquermarke=frueher. Werte mit Komma in Anführungszeichen: "-Dsee=2.5,9,290" (sonst trennt Windows sie). -->
    <target name="tempo" depends="jar" description="docs/status/Status_PhaseN.png (Grundansicht, volles HUD).">
        <property name="platform.java" value="java"/>
        <property name="phase" value="13"/>
        <property name="bild" value="docs/status/Status_Phase${phase}.png"/>
        <property name="ansicht" value=""/>
        <property name="wolken" value=""/>
        <property name="boden" value=""/>
        <property name="bedeckung" value=""/>
        <property name="kamera" value=""/>
        <property name="see" value=""/>
        <property name="pegel" value=""/>
        <property name="sandsturm" value=""/>
        <property name="wind" value=""/>
        <property name="vorlage" value=""/>
        <property name="quermarke" value=""/>
        <property name="lage" value=""/>
        <property name="regen" value=""/>
        <property name="nebel" value=""/>
        <property name="gewitter" value=""/>
        <property name="blitz" value=""/>
        <property name="leben" value=""/>
        <property name="leuchten" value=""/>
        <property name="gruen" value=""/>
        <property name="fernrohr" value=""/>
        <property name="wolke" value=""/>
        <property name="uhr" value="20.5"/>
        <property name="datum" value="2026-07-20"/>
        <java classname="com.dan.sylt.tools.Tempo" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg value="-Xmx6g"/>
            <jvmarg value="-Dhud=voll"/>
            <jvmarg value="-Dansicht=${ansicht}"/>
            <jvmarg value="-Dwolken=${wolken}"/>
            <jvmarg value="-Dboden=${boden}"/>
            <jvmarg value="-Dbedeckung=${bedeckung}"/>
            <jvmarg value="-Dkamera=${kamera}"/>
            <jvmarg value="-Dsee=${see}"/>
            <jvmarg value="-Dpegel=${pegel}"/>
            <jvmarg value="-Dsandsturm=${sandsturm}"/>
            <jvmarg value="-Dwind=${wind}"/>
            <jvmarg value="-Dvorlage=${vorlage}"/>
            <jvmarg value="-Dquermarke=${quermarke}"/>
            <jvmarg value="-Dlage=${lage}"/>
            <jvmarg value="-Dregen=${regen}"/>
            <jvmarg value="-Dnebel=${nebel}"/>
            <jvmarg value="-Dgewitter=${gewitter}"/>
            <jvmarg value="-Dblitz=${blitz}"/>
            <jvmarg value="-Dleben=${leben}"/>
            <jvmarg value="-Dleuchten=${leuchten}"/>
            <jvmarg value="-Dgruen=${gruen}"/>
            <jvmarg value="-Dfernrohr=${fernrohr}"/>
            <jvmarg value="-Dwolke=${wolke}"/>
            <arg line="120 1920 1080 ${bild} MITTEL ${uhr} ${datum}"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 10: die acht Vorlagen der Türme auf der Grafikkarte, je docs/status/Vorlage_<Name>.png (Ansicht, Öffnung, Tag
         und Stunde der Vorlage, volles HUD). Zum Vergleich mit templates/Leuchturm1–4 und Kampen1–4. -->
    <macrodef name="vorlage">
        <attribute name="name"/>
        <sequential>
            <java classname="com.dan.sylt.tools.Tempo" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
                <jvmarg value="-Dstdout.encoding=UTF-8"/>
                <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
                <jvmarg value="-Xmx6g"/>
                <jvmarg value="-Dhud=kurz"/>
                <jvmarg value="-Dvorlage=@{name}"/>
                <arg line="30 1920 1080 docs/status/Vorlage_@{name}.png MITTEL"/>
                <classpath><pathelement path="${run.classpath}"/></classpath>
            </java>
        </sequential>
    </macrodef>
    <target name="vorlagen" depends="jar" description="Phase 10: die acht Vorlagen der Türme als docs/status/Vorlage_*.png.">
        <property name="platform.java" value="java"/>
        <vorlage name="Leuchturm1"/>
        <vorlage name="Leuchturm2"/>
        <vorlage name="Leuchturm3"/>
        <vorlage name="Leuchturm4"/>
        <vorlage name="Kampen1"/>
        <vorlage name="Kampen2"/>
        <vorlage name="Kampen3"/>
        <vorlage name="Kampen4"/>
    </target>
    <!-- Phase 10: Vorschau der Bauten ohne Grafikkarte neben den Vorlagen (docs/status/Vorschau_*.png): Lage, Größe, Gestalt. -->
    <target name="bautenbild" depends="jar" description="Phase 10: Vorschau der Bauten ohne Grafikkarte neben den Vorlagen.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.sylt.tools.BautenBild" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Xmx6g"/>
            <arg line="alle docs/status"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 13: Wetter, Licht, Leben als Bilder auf der Grafikkarte (docs/status/Wetter_*.png, kurzes HUD): die Vorlagen
         Leuchturm2 (Nacht, Laterne wie früher, angestrahlt) und Leuchturm4 (bedeckt, Schauer), Seenebel an der Treppe, ein
         Gewitter über der See mit Blitz, Meeresleuchten in einer Augustnacht am Spülsaum, Sanderlinge am Spülsaum, das grüne
         Leuchten im Fernrohr. Auf der Radeon laufen lassen. -->
    <macrodef name="wetterbild">
        <attribute name="name"/>
        <attribute name="uhr" default="20.5"/>
        <attribute name="datum" default="2026-07-20"/>
        <attribute name="d1" default="-Dhud=kurz"/>
        <attribute name="d2" default="-Dhud=kurz"/>
        <attribute name="d3" default="-Dhud=kurz"/>
        <sequential>
            <java classname="com.dan.sylt.tools.Tempo" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
                <jvmarg value="-Dstdout.encoding=UTF-8"/>
                <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
                <jvmarg value="-Xmx6g"/>
                <jvmarg value="-Dhud=kurz"/>
                <jvmarg value="@{d1}"/>
                <jvmarg value="@{d2}"/>
                <jvmarg value="@{d3}"/>
                <arg line="30 1920 1080 docs/status/Wetter_@{name}.png MITTEL @{uhr} @{datum}"/>
                <classpath><pathelement path="${run.classpath}"/></classpath>
            </java>
        </sequential>
    </macrodef>
    <target name="wetterbilder" depends="jar" description="Phase 13: Wetter, Licht und Leben als docs/status/Wetter_*.png.">
        <property name="platform.java" value="java"/>
        <wetterbild name="Leuchturm2" d1="-Dvorlage=Leuchturm2"/>
        <wetterbild name="Leuchturm4" d1="-Dvorlage=Leuchturm4"/>
        <wetterbild name="Seenebel" uhr="9" datum="2026-09-20" d1="-Dansicht=Treppe" d2="-Dlage=Seenebel"/>
        <wetterbild name="Gewitter" uhr="21.5" datum="2026-08-02" d1="-Dansicht=AmKliff" d2="-Dlage=Gewitter" d3="-Dblitz=see"/>
        <wetterbild name="Meeresleuchten" uhr="23" datum="2026-08-15" d1="-Dansicht=Spuelsaum" d2="-Dleuchten=an" d3="-Dblick=250,3,10"/>
        <wetterbild name="Spuelsaum" uhr="10" datum="2026-09-20" d1="-Dansicht=Spuelsaum" d2="-Dblick=200,5,12"/>
        <wetterbild name="Gruen" uhr="21.85" datum="2026-07-20" d1="-Dfernrohr=sonne" d2="-Dgruen=3"/>
    </target>
    <!-- Phase 14: die Hörproben (WAV mit Spektrogramm) nach docs/hoerproben, ohne Grafikkarte; nur eine: -Dnur=saum|kliffuss|kante|heide|sand|gewitter|abbruch -->
    <property name="nur" value=""/>
    <target name="hoerproben" depends="jar" description="Phase 14: Hörproben als WAV mit Spektrogramm nach docs/hoerproben (ohne Grafikkarte).">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.sylt.tools.Hoerproben" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg value="-Xmx6g"/>
            <arg value="docs/hoerproben"/>
            <arg value="${nur}"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 15: die Regiebücher ohne Fenster bis zum Ende, je ein Blatt mit den Fotos nach docs/status (Regiebuch_*.png);
         nur eines: -Dbuch=Abend|Sturmflut|Jahr|Welle (Grafikkarte, gut 10 min für alle). -->
    <property name="buch" value="alle"/>
    <target name="regiebuecher" depends="jar" description="Phase 15: die vier Regiebücher ohne Fenster, Blätter mit den Fotos nach docs/status.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.sylt.tools.Tempo" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg value="-Xmx6g"/>
            <jvmarg value="-Dregiebuch=${buch}"/>
            <jvmarg value="-Dhud=aus"/>
            <arg line="1 1920 1080 - MITTEL"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 12: der Abbruch als Bildfolge auf der Grafikkarte (docs/status/Abbruch_1..6.png): Xaver bis Stunde 15, dann
         das Stück bei N 6 090 335 (oder -Dnord=…, -Dstunde=…), Physik fest 1/120 s, das letzte Bild einen Tag später (zwei Fluten). Seit Phase 13 Stunde 23 (6.12.2013 11 Uhr, hell). -->
    <property name="nord" value=""/>
    <property name="stunde" value="23"/>
    <target name="abbruch" depends="jar" description="Phase 12: der Abbruch des Kliffs als Bildfolge (Grafikkarte), docs/status/Abbruch_1..6.png.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.sylt.tools.Abbruch" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg value="-Xmx6g"/>
            <jvmarg value="-Dnord=${nord}"/>
            <jvmarg value="-Dstunde=${stunde}"/>
            <arg line="1920 1080 docs/status"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 12: dieselbe Folge im Querschnitt ohne Grafikkarte (docs/status/Abbruch_Schnitt.png) mit der Sandbilanz. -->
    <target name="abbruchbild" depends="jar" description="Phase 12: der Abbruch im Querschnitt ohne Grafikkarte, mit Sandbilanz.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.sylt.tools.AbbruchBild" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Xmx6g"/>
            <jvmarg value="-Dnord=${nord}"/>
            <jvmarg value="-Dstunde=${stunde}"/>
            <arg line="docs/status/Abbruch_Schnitt.png"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 2: die Aufbereitung (Werkbuch 2.4). Liest die Rohdaten einmal aus dem Pfad in daten/rohdaten.properties
         (Vorgabe C:\Daten\Sylt, die BAW aus Rungholt) und schreibt daten/ mit INHALT.txt und die Prüfbilder in docs/status.
         Alle Schritte rund 4 Minuten; einzeln mit -Dschritt=baw,gelaende,kante,luftbild,bauten,inhalt. -->
    <target name="aufbereitung" depends="jar" description="Phase 2: Rohdaten einmal nach daten/ (Gelände, Kante, Luftbild, Bauten, INHALT.txt).">
        <property name="platform.java" value="java"/>
        <property name="schritt" value="alle"/>
        <java classname="com.dan.sylt.tools.Aufbereitung" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <jvmarg value="-Xmx4g"/>
            <jvmarg value="-Dschritt=${schritt}"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
</project>
